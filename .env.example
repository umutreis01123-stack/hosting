# ============================
# APEX | Hosting — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve doldurun
# ============================

# Sunucu Ayarları
PORT=3000
NODE_ENV=production

# Session Güvenlik Anahtarı (Rastgele uzun bir string girin)
SESSION_SECRET=apex_super_secret_key_degistir_bunu_2024

# Discord OAuth2 Ayarları
# https://discord.com/developers/applications adresinden alın
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
# Railway deploy URL'niz (örn: https://apex-hosting.up.railway.app)
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# Owner (Kurucu) Ayarları
OWNER_DISCORD_ID=1403495996138323989
OWNER_PASSWORD=umutbaba123u

# Uygulama URL'si
APP_URL=http://localhost:3000
